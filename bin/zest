#!/usr/bin/env bash
# zest — CLI do projeto Zest 🌶️
# comandos: doctor · update · add <ferramenta> · version · help
set -u
ZEST_HOME="${ZEST_HOME:-$HOME/.config/zest}"
ZEST_REPO="${ZEST_REPO:-$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)}"
VERSION="0.3.2"

usage() {
  cat <<'EOF'
🌶️  Zest — o tempero do seu terminal

USO: zest <comando>

  doctor     Diagnostica o ambiente (ferramentas, módulos, sintaxe)
  update     Atualiza tudo (12 gerenciadores; pula o que não existe)
  self-update Atualiza o próprio Zest para a última versão no GitHub
             (sem root: módulos, lib e bin em ~/.config/zest e ~/.local/bin)
  prompt     Mostra ou troca o prompt:  zest prompt compact
             (estilos: zest · compact · plain · off)
  add        Instala uma ferramenta sem root:  zest add fzf
  version    Mostra a versão
  help       Esta ajuda
EOF
}

cmd_doctor() {
  local ok=0 warn=0 MODDIR n_tools=0
  MODDIR="$ZEST_HOME"
  [[ -d "$MODDIR/modules" ]] || MODDIR="$ZEST_REPO"   # instalado > repositório
  echo "🌶️  Zest doctor — diagnóstico do ambiente"
  echo "═══════════════════════════════════════"
  echo "· módulos de: $MODDIR"

  printf '%-32s' "· zsh"
  if command -v zsh >/dev/null 2>&1; then
    echo "✓ $(zsh --version | head -1)"
  else
    echo "✗ FALTANDO (essencial)"; ok=1
  fi

  printf '%-32s' "· shell padrão"
  local LOGIN_SHELL
  LOGIN_SHELL=$(getent passwd "$(id -un)" 2>/dev/null | cut -d: -f7)
  [[ -z "$LOGIN_SHELL" ]] && LOGIN_SHELL="${SHELL:-?}"
  if [[ "$LOGIN_SHELL" == *"zsh" ]]; then
    echo "✓ $LOGIN_SHELL"
  else
    # é assim que o Zest "não funciona" em máquina nova: o terminal abre bash
    echo "→ $LOGIN_SHELL — o Zest não carrega aí. Troque com:"
    printf '%-32s  sudo chsh -s %s %s\n' "" "$(command -v zsh)" "$(id -un)"
    warn=$((warn+1))
  fi

  printf '%-32s' "· Oh My Zsh"
  [[ -d "$HOME/.oh-my-zsh" ]] && echo "✓" || { echo "→ não instalado (opcional, módulos funcionam sem)"; warn=$((warn+1)); }

  # lista de ferramentas: fonte única (lib/tools.list), com fallback para o repositório
  # Cada linha: <nome-para-zest-add>\t<binário-real>. A segunda coluna é o que
  # command -v testa — sem ela o doctor pergunta "zest add ripgrep" mesmo
  # tendo o `rg` em ~/.local/bin.
  local TOOLS_FILE
  TOOLS_FILE="$ZEST_HOME/lib/tools.list"
  [[ -f "$TOOLS_FILE" ]] || TOOLS_FILE="$ZEST_REPO/lib/tools.list"
  while IFS=$'\t' read -r _t _b; do
    [[ -z "$_t" || "$_t" == \#* || "$_t" == \(* ]] && continue
    _b="${_b:-$_t}"
    n_tools=$((n_tools + 1))
    printf '%-32s' "· $_t"
    if command -v "$_b" >/dev/null 2>&1; then
      echo "✓"
    else
      echo "→ não instalado (zest add $_t)"; warn=$((warn+1))
    fi
  done <"$TOOLS_FILE"
  unset _t _b

  printf '%-32s' "· gerenciador de pacotes"
  local PM_DOC="" p
  for p in apt-get dnf pacman zypper apk; do
    command -v "$p" >/dev/null 2>&1 && { PM_DOC="$p"; break; }
  done
  if [[ -n "$PM_DOC" ]]; then
    echo "✓ $PM_DOC"
  else
    echo "→ nenhum (apt/dnf/pacman/zypper/apk) — só binários de release"
    warn=$((warn+1))
  fi

  printf '%-32s' "· sintaxe dos módulos"
  local bad=0 f
  for f in "$MODDIR"/modules/*.zsh; do
    zsh -n "$f" 2>/dev/null || { bad=1; echo "✗ erro em $f"; }
  done
  (( bad == 0 )) && echo "✓"

  printf '%-32s' "· .zshrc (parse pelo zsh)"
  if [[ -f "$HOME/.zshrc" ]] && command -v zsh >/dev/null 2>&1; then
    if zsh -n "$HOME/.zshrc" 2>/dev/null; then
      echo "✓"
    else
      echo "✗ erro de sintaxe — rode o instalador de novo (ele cura sozinho)"
      ok=1
    fi
  else
    echo "→ sem ~/.zshrc"
  fi

  printf '%-32s' "· funções carregam"
  if ZEST_QUIET=1 zsh -c '
    for f in '"$MODDIR"'/modules/*.zsh(N); do source "$f"; done
    for fn in sysinfo topmem topcpu note todo syncdir updateall portcheck backup_dir worldtime git; do
      (( $+functions[$fn] )) || { echo "✗ faltando: $fn"; exit 1 }
    done' 2>/dev/null; then
    echo "✓"
  else
    echo "✗"; ok=1
  fi

  printf '%-32s' "· git (identidade p/ commits)"
  if command git config --global user.name >/dev/null 2>&1; then
    echo "✓ $(command git config --global user.name)"
  else
    echo "→ configure: git config --global user.name/user.email"; warn=$((warn+1))
  fi

  echo "═══════════════════════════════════════"
  # 8 checagens fora as ferramentas: zsh · shell padrão · Oh My Zsh · gerenciador
  # de pacotes · sintaxe dos módulos · .zshrc · funções · git
  echo "Resumo: $(( n_tools + 8 )) verificações · avisos: $warn"
  (( ok == 0 )) && echo "✅ Base saudável!" || echo "❌ Problemas encontrados acima."
}

cmd_update() {
  ZEST_QUIET=1 zsh -c '
    for f in '"$ZEST_HOME"'/modules/*.zsh(N); do source "$f"; done
    updateall'
}

# zest self-update — baixa a versão mais recente do GitHub e atualiza o Zest
# locally (módulos, lib, bin). Sem root: tudo em $HOME/.config/zest e
# ~/.local/bin. Usa o redirect do GitHub (api.github.com dão 403).
cmd_self_update() {
  local tag url latest tmp
  tag=$(curl -fsSL --proto '=https' --tlsv1.2 --max-time 30 \
         -o /dev/null -w '%{url_effective}' \
         "https://github.com/reginaldosevero/zest/releases/latest" 2>/dev/null) || {
    echo "❌ Não consegui verificar a versão mais recente (sem internet?)"
    return 1
  }
  latest="${tag##*/releases/tag/}"
  [[ -n "$latest" ]] || { echo "❌ Não entendi a tag: $tag"; return 1; }

  if [[ "$latest" == "$VERSION" ]]; then
    echo "✓ Zest já está na versão mais recente ($VERSION)"
    return 0
  fi
  echo "· Versão atual: $VERSION → mais recente: $latest"
  url="https://github.com/reginaldosevero/zest/archive/refs/tags/$latest.tar.gz"
  tmp="$(mktemp -d)"
  if ! curl -fsSL --proto '=https' --tlsv1.2 --max-time 120 -o "$tmp/zest.tar.gz" "$url" 2>/dev/null; then
    echo "❌ Falha ao baixar $latest"; rm -rf "$tmp"; return 1
  fi
  if ! tar xzf "$tmp/zest.tar.gz" -C "$tmp" 2>/dev/null; then
    echo "❌ Falha ao descompactar"; rm -rf "$tmp"; return 1
  fi
  local src
  src=$(find "$tmp" -maxdepth 1 -mindepth 1 -name 'zest-*' -type d -print -quit)
  [[ -n "$src" ]] || { echo "❌ Estrutura inesperada no tarball"; rm -rf "$tmp"; return 1; }
  # atualiza módulos, lib e bin (idempotente, sem tocar no .zshrc)
  mkdir -p "$ZEST_HOME/modules" "$ZEST_HOME/lib" "$HOME/.local/bin"
  cp "$src"/modules/*.zsh "$ZEST_HOME/modules/" 2>/dev/null || true
  [[ -d "$src/lib" ]] && cp -r "$src"/lib/* "$ZEST_HOME/lib/" 2>/dev/null || true
  cp "$src/bin/zest" "$HOME/.local/bin/.zest.tmp.$$" 2>/dev/null
  chmod +x "$HOME/.local/bin/.zest.tmp.$$" 2>/dev/null
  mv -f "$HOME/.local/bin/.zest.tmp.$$" "$HOME/.local/bin/zest" 2>/dev/null
  rm -rf "$tmp"
  echo "✅ Zest atualizado para $latest — rode 'exec zsh' (ou abra um terminal novo)"
}

cmd_add() {
  [[ -f "$ZEST_HOME/lib/install-tool.sh" ]] || { echo "lib/install-tool.sh não encontrado"; exit 1; }
  bash "$ZEST_HOME/lib/install-tool.sh" "$@"
}

# Troca o estilo do prompt sem editar arquivo na mão.
#
# Por que não recusa mais quando há Oh My Zsh/starship/p10k:
#   o módulo 22-prompt já respeita um PS1 pré-existente (nunca sobrescreve
#   sem que a pessoa peça). O que `zest prompt compact` faz é gravar o estilo
#   em $ZEST_HOME/prompt e exportar ZEST_PROMPT no bloco do .zshrc, então o
#   módulo 22-prompt lê essa variável em primeiro lugar e aplica o prompt do
#   Zest. Quem não quer mais o Zest no prompt basta `zest prompt off`.
cmd_prompt() {
  local atual estilo
  atual=$(cat "$ZEST_HOME/prompt" 2>/dev/null || echo off)
  case "${1:-}" in
    zest|compact|plain|off)
      estilo="$1"
      mkdir -p "$ZEST_HOME"
      echo "$estilo" > "$ZEST_HOME/prompt"
      # ZEST_PROMPT no .zshrc: o módulo 22-prompt lê essa variável antes de
      # anything else, então o estilo é respeitado mesmo com omz/starship.
      # Três casos: variável já existe (atualiza), bloco zest existe (insere),
      # ou não há nada (cria um bloco novo).
      if [[ -f "$HOME/.zshrc" ]]; then
        if grep -q "^export ZEST_PROMPT=" "$HOME/.zshrc"; then
          sed -i "s/^export ZEST_PROMPT=.*/export ZEST_PROMPT=$estilo/" "$HOME/.zshrc"
        elif grep -q ">>> zest >>>" "$HOME/.zshrc"; then
          sed -i "/^# >>> zest >>>$/a export ZEST_PROMPT=$estilo" "$HOME/.zshrc"
        else
          cat >> "$HOME/.zshrc" <<'ZEOF'

# >>> zest >>>
export ZEST_PROMPT=ZPLACEHOLDER
# <<< zest <<<
ZEOF
          sed -i "s/ZPLACEHOLDER/$estilo/" "$HOME/.zshrc"
        fi
      fi
      echo "✓ prompt = $estilo — rode 'exec zsh' (ou abra um terminal novo) para ver"
      ;;
    ""|status)
      echo "prompt atual: $atual"
      echo "opções:       zest | compact | plain | off"
      ;;
    *)
      echo "estilo inválido: $1"
      echo "use: zest prompt [zest|compact|plain|off]"
      return 1
      ;;
  esac
}

case "${1:-help}" in
  doctor)  cmd_doctor ;;
  update)  cmd_update ;;
  self-update) cmd_self_update ;;
  prompt)  shift; cmd_prompt "$@" ;;
  add)     shift; cmd_add "$@" ;;
  version) echo "zest $VERSION" ;;
  help|*)  usage ;;
esac
